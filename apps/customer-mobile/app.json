{
  "expo": {
    "name": "ChiruDeli",
    "slug": "chirudeli-customer",
    "scheme": "chirudeli",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#0E6E4E"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "zm.chirudeli.customer"
    },
    "android": {
      "package": "zm.chirudeli.customer",
      "adaptiveIcon": {
        "backgroundColor": "#0E6E4E"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-secure-store",
      "expo-location"
    ],
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/730574e7-4854-4875-9ee3-3229d32f1943"
    },
    "extra": {
      "eas": {
        "projectId": "730574e7-4854-4875-9ee3-3229d32f1943"
      }
    },
    "owner": "preacher26s-team"
  }
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ─────────────────────────────────────────────────────────────────
// Keep these in lockstep with packages/shared-types/src/enums.ts.

enum UserRole {
  CUSTOMER
  STORE_MANAGER
  RIDER
  SYSTEM_ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  PENDING
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Store approval/lifecycle status. Deliberately separate from `isActivated`
/// (Business, below) — a store can be APPROVED but not yet activated
/// (onboarding incomplete), and customer visibility requires both.
enum BusinessStatus {
  DRAFT
  SUBMITTED
  PENDING_APPROVAL
  UNDER_REVIEW
  APPROVED
  REJECTED
  RESUBMISSION
  SUSPENDED
  DEACTIVATED
}

enum StoreState {
  OPEN
  PAUSED
}

enum RiderOnlineStatus {
  ONLINE
  OFFLINE
}

enum VehicleType {
  BICYCLE
  MOTORCYCLE
  CAR
  ON_FOOT
}

enum DocumentType {
  NATIONAL_ID
  DRIVERS_LICENSE
  VEHICLE_REGISTRATION
  PROFILE_PHOTO
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Coarse, customer-facing store-order lifecycle — drives the tracking screen.
/// Every store order in a master order moves through this independently,
/// except RIDER_ASSIGNED/ON_THE_WAY/DELIVERED which the rider's progress
/// through the shared delivery stops applies to all of them at once.
enum OrderStatus {
  PENDING_CONFIRMATION
  CONFIRMED
  PREPARING
  READY_FOR_PICKUP
  RIDER_ASSIGNED
  PICKED_UP
  ON_THE_WAY
  DELIVERED
  CANCELLED
}

/// Overall progress of a rider's multi-stop delivery run.
enum MasterDeliveryStatus {
  ASSIGNED
  IN_PROGRESS
  COMPLETED
}

enum DeliveryStopType {
  PICKUP
  DROPOFF
}

enum DeliveryStopStatus {
  PENDING
  ARRIVED
  COMPLETED
}

/// Deliberately separate from OrderStatus/delivery progress (business rule #13).
enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CASH_ON_DELIVERY
  MOBILE_MONEY
  CARD
}

enum TransactionType {
  CHARGE
  REFUND
  PAYOUT
}

enum DeliveryFeeType {
  DISTANCE_BASED
  FIXED_ZONE
}

enum PromotionType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_DELIVERY
}

enum NotificationType {
  ORDER_CONFIRMED
  ORDER_ACCEPTED
  ORDER_PREPARING
  RIDER_ASSIGNED
  RIDER_APPROACHING
  ORDER_DELIVERED
  ORDER_CANCELLED
  PROMOTION
  NEW_ORDER
  NEW_DELIVERY_REQUEST
  DELIVERY_INSTRUCTIONS_UPDATED
  ACCOUNT_STATUS_CHANGED
  STORE_APPROVED
  STORE_REJECTED
  STORE_CHANGES_REQUESTED
  STORE_SUSPENDED
  STORE_REACTIVATED
}

// ── Identity & access ────────────────────────────────────────────────────

model User {
  id           String        @id @default(uuid())
  role         UserRole
  phone        String        @unique
  email        String?       @unique
  passwordHash String
  status       AccountStatus @default(ACTIVE)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  lastLoginAt  DateTime?

  customer      Customer?
  rider         Rider?
  adminUser     AdminUser?
  storeManager  StoreManager?
  addresses     Address[]
  notifications Notification[]
  auditLogs     AuditLog[]     @relation("AuditActor")
}

model Customer {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id])
  displayName     String
  profilePhotoUrl String?
  createdAt       DateTime @default(now())

  masterOrders          MasterOrder[]
  storeOrders           Order[]
  favoriteBusinesses    FavoriteBusiness[]
  favoriteProducts      FavoriteProduct[]
  reviews               Review[]
  promotionRedemptions  PromotionRedemption[]
}

model Address {
  id                   String   @id @default(uuid())
  userId               String
  user                 User     @relation(fields: [userId], references: [id])
  label                String
  line1                String
  area                 String
  latitude             Float
  longitude            Float
  deliveryInstructions String?
  isDefault            Boolean  @default(false)
  createdAt            DateTime @default(now())

  masterOrders MasterOrder[]

  @@index([userId])
}

model AdminUser {
  id               String  @id @default(uuid())
  userId           String  @unique
  user             User    @relation(fields: [userId], references: [id])
  fullName         String
  permissionLevel  String  @default("STANDARD")
  twoFactorSecret  String?
  twoFactorEnabled Boolean @default(false)
}

/// Personal profile for a STORE_MANAGER user — parallel to Customer/Rider.
/// A manager's actual store access is via StoreManagerAssignment, not a
/// direct FK here, so the data model already supports one manager running
/// several stores or several managers sharing one store.
model StoreManager {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id])
  fullName        String
  profilePhotoUrl String?
  nationalIdInfo  String?
  createdAt       DateTime @default(now())

  assignments StoreManagerAssignment[]
}

// ── Businesses & catalog ─────────────────────────────────────────────────

/// System-admin-managed store class (Restaurant, Pharmacy, Hardware, ...).
/// Deliberately data, not an enum — the admin can create/edit/deactivate
/// classes from the dashboard without a code change or deploy.
model StoreClass {
  id            String   @id @default(uuid())
  name          String
  slug          String   @unique
  description   String   @default("")
  icon          String?
  coverImageUrl String?
  isActive      Boolean  @default(true)
  /// Independent of isActive — an active class can still be hidden from the
  /// customer app while stores are still being onboarded into it.
  isVisible     Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  requiredDocuments StoreClassDocumentRequirement[]
  businesses        Business[]
}

/// Admin-defined document requirement for a store class — a free-text
/// label, not a hardcoded document-type enum, so "Pharmacy Licence" or any
/// future document type never needs a code change.
model StoreClassDocumentRequirement {
  id            String     @id @default(uuid())
  storeClassId  String
  storeClass    StoreClass @relation(fields: [storeClassId], references: [id])
  documentLabel String
  isRequired    Boolean    @default(true)
  sortOrder     Int        @default(0)

  storeDocuments StoreDocument[]

  @@index([storeClassId])
}

model Business {
  id           String     @id @default(uuid())
  name         String
  slug         String     @unique
  storeClassId String
  storeClass   StoreClass @relation(fields: [storeClassId], references: [id])
  description  String     @default("")
  logoUrl      String?
  coverImageUrl String?
  phone         String?
  email         String?
  registrationNumber String?
  taxId              String?

  status      BusinessStatus @default(DRAFT)
  /// Flips true via the "Activate Store" action once onboarding is
  /// complete — kept separate from `status` because customer visibility
  /// needs "approved AND activated", two independent facts (spec §9/§10).
  isActivated Boolean        @default(false)
  rejectionReason String?
  storeState  StoreState     @default(OPEN)

  latitude     Float
  longitude    Float
  address      String
  openingHours Json
  prepTimeMinutes Int @default(20)
  zoneId       String?
  zone         DeliveryZone? @relation(fields: [zoneId], references: [id])
  commissionOverridePercent Decimal? @db.Decimal(5, 2)
  ratingAvg    Float    @default(0)
  ratingCount  Int      @default(0)
  createdAt    DateTime @default(now())
  submittedAt  DateTime?
  approvedAt   DateTime?
  approvedById String?
  activatedAt  DateTime?

  managers          StoreManagerAssignment[]
  documents         StoreDocument[]
  productCategories ProductCategory[]
  products          Product[]
  orders            Order[]
  reviews           Review[]
  promotions        Promotion[]
  favoritedBy       FavoriteBusiness[]

  @@index([storeClassId])
  @@index([status])
}

/// Join table between StoreManager and Business — a manager only ever sees
/// stores they're assigned to (enforced server-side via requireManagedBusiness,
/// never trusting a client-supplied store id). Modeled many-to-many from day
/// one even though today's flows create exactly one assignment per store.
model StoreManagerAssignment {
  id             String       @id @default(uuid())
  businessId     String
  business       Business     @relation(fields: [businessId], references: [id])
  storeManagerId String
  storeManager   StoreManager @relation(fields: [storeManagerId], references: [id])
  isPrimary      Boolean      @default(true)
  assignedAt     DateTime     @default(now())

  @@unique([businessId, storeManagerId])
  @@index([storeManagerId])
  @@index([businessId])
}

/// A document uploaded against a store's registration — either satisfying a
/// specific StoreClassDocumentRequirement or an ad hoc upload (requirementId
/// null). File bytes live behind the DocumentStorageProvider interface
/// (lib/documentStorage.ts); `fileData` is provider-opaque storage content,
/// not necessarily a raw byte string forever.
model StoreDocument {
  id            String                          @id @default(uuid())
  businessId    String
  business      Business                        @relation(fields: [businessId], references: [id])
  requirementId String?
  requirement   StoreClassDocumentRequirement?   @relation(fields: [requirementId], references: [id])
  label         String
  fileData      String
  mimeType      String
  status        DocumentStatus                  @default(PENDING)
  reviewNote    String?
  uploadedAt    DateTime                        @default(now())
  reviewedAt    DateTime?
  reviewedById  String?

  @@index([businessId])
}

model ProductCategory {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id])
  name       String
  sortOrder  Int      @default(0)

  products Product[]

  @@index([businessId])
}

model Product {
  id          String   @id @default(uuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id])
  categoryId  String
  category    ProductCategory @relation(fields: [categoryId], references: [id])
  name        String
  description String   @default("")
  price       Decimal  @db.Decimal(10, 2)
  imageUrl    String?
  isAvailable Boolean  @default(true)
  stock       Int?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  addOns      ProductAddOn[]
  orderItems  OrderItem[]
  favoritedBy FavoriteProduct[]

  @@index([businessId])
  @@index([categoryId])
}

model ProductAddOn {
  id         String  @id @default(uuid())
  productId  String
  product    Product @relation(fields: [productId], references: [id])
  name       String
  priceDelta Decimal @db.Decimal(10, 2) @default(0)

  @@index([productId])
}

// ── Platform / ops ───────────────────────────────────────────────────────

/// A zone both defines "is this address inside our service area?" and how
/// its delivery fee is computed — this is how "Chirundu only, for now" is
/// enforced without ever hardcoding the town name in application logic.
model DeliveryZone {
  id              String          @id @default(uuid())
  name            String          @unique
  isServiceArea   Boolean         @default(true)
  feeType         DeliveryFeeType @default(DISTANCE_BASED)
  fixedFee        Decimal?        @db.Decimal(10, 2)
  centerLatitude  Float
  centerLongitude Float
  radiusKm        Float
  createdAt       DateTime        @default(now())

  businesses Business[]
}

/// Versioned global default fee config (base + per-km). Only one row should
/// have isActive=true at a time; history is kept for reporting.
model DeliveryFeeConfig {
  id            String   @id @default(uuid())
  baseFee       Decimal  @db.Decimal(10, 2)
  perKmFee      Decimal  @db.Decimal(10, 2)
  isActive      Boolean  @default(true)
  effectiveFrom DateTime @default(now())
}

model AuditLog {
  id          String   @id @default(uuid())
  actorUserId String?
  actor       User?    @relation("AuditActor", fields: [actorUserId], references: [id])
  action      String
  entityType  String
  entityId    String
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
}

// ── Orders & delivery ────────────────────────────────────────────────────

/// The customer's single checkout event — one cart, one payment, one
/// delivery run — split internally into one StoreOrder (Order, below) per
/// business the cart touched. The customer sees only this; each business
/// sees only its own StoreOrder.
model MasterOrder {
  id          String   @id @default(uuid())
  orderNumber String   @unique
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id])
  addressId   String
  address     Address  @relation(fields: [addressId], references: [id])

  paymentMethod PaymentMethod
  paymentStatus PaymentStatus @default(UNPAID)

  subtotal       Decimal @db.Decimal(10, 2)
  deliveryFee    Decimal @db.Decimal(10, 2)
  serviceFee     Decimal @db.Decimal(10, 2)
  discountAmount Decimal @db.Decimal(10, 2) @default(0)
  total          Decimal @db.Decimal(10, 2)

  deliveryFeeOverridden Boolean @default(false)
  deliveryInstructions  String?
  /// Client-generated key; unique constraint is what makes double-submit safe.
  idempotencyKey        String  @unique
  promotionId           String?
  promotion             Promotion? @relation(fields: [promotionId], references: [id])
  cancelReason          String?

  /// One rider handles the whole multi-stop run, so their rating is
  /// captured once per master order rather than once per store.
  riderRating  Int?
  riderComment String?

  placedAt    DateTime  @default(now())
  cancelledAt DateTime?

  storeOrders         Order[]
  delivery            MasterDelivery?
  payment             Payment?
  promotionRedemption PromotionRedemption?

  @@index([customerId])
}

/// One per business touched by a MasterOrder — a "Store Order". A business
/// only ever queries its own rows here; it has no way to see sibling store
/// orders under the same master order.
model Order {
  id            String      @id @default(uuid())
  orderNumber   String      @unique
  masterOrderId String
  masterOrder   MasterOrder @relation(fields: [masterOrderId], references: [id])
  /// Position in the rider's pickup route (1-based) — mirrors the linked
  /// DeliveryStop once a rider is assigned.
  sequence      Int
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id])
  businessId    String
  business      Business @relation(fields: [businessId], references: [id])

  status OrderStatus @default(PENDING_CONFIRMATION)

  subtotal Decimal @db.Decimal(10, 2)

  // Snapshotted at creation so later admin changes never rewrite history.
  commissionPercent    Decimal @db.Decimal(5, 2)
  commissionAmount     Decimal @db.Decimal(10, 2)
  businessPayoutAmount Decimal @db.Decimal(10, 2)

  cancelReason String?

  confirmedAt DateTime?
  preparingAt DateTime?
  readyAt     DateTime?
  pickedUpAt  DateTime?
  deliveredAt DateTime?
  cancelledAt DateTime?

  items        OrderItem[]
  review       Review?
  statusEvents OrderStatusEvent[]
  commission   Commission?
  pickupStop   DeliveryStop?

  @@unique([masterOrderId, businessId])
  @@index([masterOrderId])
  @@index([customerId])
  @@index([businessId])
  @@index([status])
}

model OrderItem {
  id                  String  @id @default(uuid())
  orderId             String
  order               Order   @relation(fields: [orderId], references: [id])
  productId           String
  product             Product @relation(fields: [productId], references: [id])
  nameSnapshot        String
  priceSnapshot       Decimal @db.Decimal(10, 2)
  quantity            Int
  addOnsLabel         String?
  addOnsPriceSnapshot Decimal @db.Decimal(10, 2) @default(0)
  specialInstructions String?

  @@index([orderId])
}

/// Append-only audit trail behind the tracking screen's status timeline.
model OrderStatusEvent {
  id              String      @id @default(uuid())
  orderId         String
  order           Order       @relation(fields: [orderId], references: [id])
  status          OrderStatus
  changedByUserId String?
  changedAt       DateTime    @default(now())

  @@index([orderId])
}

model Rider {
  id                    String            @id @default(uuid())
  userId                String            @unique
  user                  User              @relation(fields: [userId], references: [id])
  fullName              String
  nationalId            String
  profilePhotoUrl       String?
  vehicleType           VehicleType
  vehicleRegNo          String?
  licenseNo             String?
  emergencyContactName  String
  emergencyContactPhone String
  payoutMethod          String?
  payoutDetails         String?

  status          ApprovalStatus    @default(PENDING)
  onlineStatus    RiderOnlineStatus @default(OFFLINE)
  currentLatitude  Float?
  currentLongitude Float?
  lastLocationAt  DateTime?
  ratingAvg       Float             @default(0)
  ratingCount     Int               @default(0)
  approvedAt      DateTime?
  approvedById    String?
  createdAt       DateTime          @default(now())

  documents     RiderDocument[]
  deliveries    MasterDelivery[]
  locationPings DeliveryLocationPing[]
}

model RiderDocument {
  id         String         @id @default(uuid())
  riderId    String
  rider      Rider          @relation(fields: [riderId], references: [id])
  type       DocumentType
  fileUrl    String
  status     DocumentStatus @default(PENDING)
  uploadedAt DateTime       @default(now())
  reviewedAt DateTime?

  @@index([riderId])
}

/// A rider's single multi-stop run for one master order: pick up from every
/// store the cart touched, then deliver everything to the customer.
model MasterDelivery {
  id            String      @id @default(uuid())
  masterOrderId String      @unique
  masterOrder   MasterOrder @relation(fields: [masterOrderId], references: [id])
  riderId       String?
  rider         Rider?      @relation(fields: [riderId], references: [id])

  status            MasterDeliveryStatus @default(ASSIGNED)
  totalDistanceKm   Float
  estimatedEarnings Decimal              @db.Decimal(10, 2)
  actualEarnings    Decimal?             @db.Decimal(10, 2)
  /// Shown to the rider, confirmed by the customer at the final handoff.
  deliveryPin       String

  assignedAt  DateTime  @default(now())
  completedAt DateTime?

  stops         DeliveryStop[]
  locationPings DeliveryLocationPing[]

  @@index([riderId])
}

/// One PICKUP row per store (in visiting order) plus a final DROPOFF row at
/// the customer. The rider completes them strictly in `sequence` order.
model DeliveryStop {
  id               String           @id @default(uuid())
  masterDeliveryId String
  masterDelivery   MasterDelivery   @relation(fields: [masterDeliveryId], references: [id])
  sequence         Int
  type             DeliveryStopType
  /// Set for PICKUP stops, null for the final DROPOFF stop.
  storeOrderId     String?          @unique
  storeOrder       Order?           @relation(fields: [storeOrderId], references: [id])
  label            String
  latitude         Float
  longitude        Float

  status      DeliveryStopStatus @default(PENDING)
  arrivedAt   DateTime?
  completedAt DateTime?

  @@index([masterDeliveryId, sequence])
}

/// Append-only GPS trail — drives the live map + route history.
model DeliveryLocationPing {
  id               String         @id @default(uuid())
  masterDeliveryId String
  masterDelivery   MasterDelivery @relation(fields: [masterDeliveryId], references: [id])
  riderId          String
  rider            Rider          @relation(fields: [riderId], references: [id])
  latitude         Float
  longitude        Float
  recordedAt       DateTime       @default(now())

  @@index([masterDeliveryId, recordedAt])
}

// ── Payments & money ─────────────────────────────────────────────────────

model Payment {
  id            String        @id @default(uuid())
  masterOrderId String        @unique
  masterOrder   MasterOrder   @relation(fields: [masterOrderId], references: [id])
  method        PaymentMethod
  status        PaymentStatus @default(UNPAID)
  amount        Decimal       @db.Decimal(10, 2)
  providerRef   String?
  initiatedAt   DateTime      @default(now())
  completedAt   DateTime?

  transactions Transaction[]
}

model Transaction {
  id          String           @id @default(uuid())
  paymentId   String
  payment     Payment          @relation(fields: [paymentId], references: [id])
  type        TransactionType
  amount      Decimal          @db.Decimal(10, 2)
  status      PaymentStatus
  providerRef String?
  createdAt   DateTime         @default(now())

  @@index([paymentId])
}

/// Ledger row per store order — kept separate from Order's own snapshot
/// fields for reporting flexibility (e.g. payout batching).
model Commission {
  id         String   @id @default(uuid())
  orderId    String   @unique
  order      Order    @relation(fields: [orderId], references: [id])
  businessId String
  percent    Decimal  @db.Decimal(5, 2)
  amount     Decimal  @db.Decimal(10, 2)
  createdAt  DateTime @default(now())

  @@index([businessId])
}

// ── Marketing & trust ────────────────────────────────────────────────────

model Promotion {
  id                String        @id @default(uuid())
  code              String        @unique
  type              PromotionType
  value             Decimal       @db.Decimal(10, 2)
  businessId        String?
  business          Business?     @relation(fields: [businessId], references: [id])
  minOrderAmount    Decimal?      @db.Decimal(10, 2)
  maxDiscountAmount Decimal?      @db.Decimal(10, 2)
  usageLimit        Int?
  perCustomerLimit  Int?          @default(1)
  startsAt          DateTime      @default(now())
  endsAt            DateTime?
  isActive          Boolean       @default(true)
  createdAt         DateTime      @default(now())

  masterOrders MasterOrder[]
  redemptions  PromotionRedemption[]
}

model PromotionRedemption {
  id            String      @id @default(uuid())
  promotionId   String
  promotion     Promotion   @relation(fields: [promotionId], references: [id])
  customerId    String
  customer      Customer    @relation(fields: [customerId], references: [id])
  masterOrderId String      @unique
  masterOrder   MasterOrder @relation(fields: [masterOrderId], references: [id])
  redeemedAt    DateTime    @default(now())

  @@index([promotionId, customerId])
}

/// One row per store order — the business rating for that specific store.
/// The rider (shared across the whole master order) is rated once, on
/// MasterOrder.riderRating, instead of being repeated here per store.
model Review {
  id              String   @id @default(uuid())
  orderId         String   @unique
  order           Order    @relation(fields: [orderId], references: [id])
  customerId      String
  customer        Customer @relation(fields: [customerId], references: [id])
  businessId      String
  business        Business @relation(fields: [businessId], references: [id])
  businessRating  Int
  businessComment String?
  isModerated     Boolean  @default(false)
  isHidden        Boolean  @default(false)
  createdAt       DateTime @default(now())
}

model FavoriteBusiness {
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  businessId String
  business   Business @relation(fields: [businessId], references: [id])
  createdAt  DateTime @default(now())

  @@id([customerId, businessId])
}

model FavoriteProduct {
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  createdAt  DateTime @default(now())

  @@id([customerId, productId])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  type      NotificationType
  title     String
  body      String
  data      Json?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, isRead])
}

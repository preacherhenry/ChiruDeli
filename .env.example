# ── Database (Neon Postgres) ────────────────────────────────────────────────
# Create a free project at https://neon.tech, then paste the pooled connection
# string here. Must include ?sslmode=require.
DATABASE_URL="postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/chirudeli?sslmode=require"

# ── Auth ─────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET="change-me-dev-only"
JWT_REFRESH_SECRET="change-me-dev-only-too"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# ── API server ───────────────────────────────────────────────────────────────
PORT=4000
HOST="0.0.0.0"
CORS_ORIGIN="*"
NODE_ENV="development"

# ── Platform defaults (seed uses these if set) ─────────────────────────────
DEFAULT_COMMISSION_PERCENT=10
DEFAULT_BASE_DELIVERY_FEE=15
DEFAULT_PER_KM_DELIVERY_FEE=5

# ── External providers (optional — app degrades gracefully without these) ──
GOOGLE_MAPS_API_KEY=""
SMS_PROVIDER="console"
MOBILE_MONEY_PROVIDER="stub"

# ── Mobile app (Expo) ────────────────────────────────────────────────────────
EXPO_PUBLIC_API_URL="http://localhost:4000"
EXPO_PUBLIC_WS_URL="http://localhost:4000"
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=""
